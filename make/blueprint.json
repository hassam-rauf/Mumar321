          {
            "name": "tz",
            "value": "America/New_York"
          },
          {
            "name": "open_days",
            "value": "1,2,3,4,5"
          },
          {
            "name": "open_hhmm",
            "value": "900"
          },
          {
            "name": "close_hhmm",
            "value": "1700"
          },
          {
            "name": "force_route",
            "value": ""
          }
        ],
        "scope": "roundtrip"
      },
      "metadata": {
        "designer": {
          "x": 8700,
          "y": 0,
          "name": "Config"
        }
      }
    },
    {
      "id": 3,
