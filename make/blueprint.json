{
  "name": "Woo AI Support Agent (NEEDS MANUAL REVIEW)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": null,
        "maxResults": 1
