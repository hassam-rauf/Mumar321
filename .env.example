# --- Local WordPress/WooCommerce (docker-compose) ---
WP_PORT=8080
DB_PASSWORD=change-me
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=admin@example.com

# --- WooCommerce REST API (filled in after `scripts/setup-store.sh`) ---
# Use your HTTPS tunnel URL here when testing from Make (Make cannot reach localhost).
WOO_URL=http://localhost:8080
WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Business hours (same values go into the Make "Set variables" module) ---
STORE_TZ=America/New_York
BUSINESS_DAYS=1,2,3,4,5        # ISO weekdays, 1=Mon ... 7=Sun
BUSINESS_OPEN=0900             # HHmm, 24h
BUSINESS_CLOSE=1700            # HHmm, 24h
FORCE_ROUTE=                   # demo only: "transfer" or "message" to override the clock

# --- Webhook used by scripts/test_webhook.py (Make URL or the local reference server) ---
WEBHOOK_URL=http://localhost:8787

# --- Vapi voice agent (docs/vapi-setup.md) ---
PUBLIC_URL=                    # HTTPS tunnel URL of webhook_server.py
VAPI_API_KEY=                  # Vapi private API key
VAPI_SECRET=                   # optional shared secret, sent by Vapi as x-vapi-secret
TRANSFER_NUMBER=               # optional E.164 number for live transfers
VAPI_ASSISTANT_ID=             # set after the first scripts/vapi_setup.py run

# --- Gemini Live web call (free tier; demo/gemini_call.html at http://localhost:8787/gemini) ---
GEMINI_API_KEY=                # free key from https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore              # any Gemini prebuilt voice, e.g. Kore, Aoede, Puck
